# Packages removed from the rootfs AFTER configuration, before squashfs.
# These are only needed during the build and must not appear in the final image.
# Processed by scripts/clean-rootfs.sh (uses dpkg --purge while apt is still present,
# then apt itself is also removed at the end of that script).

apt
apt-utils
apt-transport-https
aptitude
debconf-utils
python3-apt
python3-debian
dpkg-dev
debianutils
tasksel
tasksel-data

# No privilege escalation on the immutable OS — root is locked and there is no
# admin path; updates happen from install/upgrade media, not in-session.
sudo
