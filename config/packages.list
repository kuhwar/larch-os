# larch-os package list — installed via apk inside Alpine chroot
# Lines starting with # are comments; blank lines are ignored.
# Processed by scripts/setup-chroot.sh

# ── Base / boot ───────────────────────────────────────────────────────────────
linux-lts
openrc
eudev
dbus
bash
coreutils
util-linux
procps
findutils
grep
sed
gawk
tar
gzip
xz
zstd
iproute2
iputils
less
which
kmod
pciutils
usbutils
lsof
vim
nano
curl
wget
ca-certificates
openssl
sudo
shadow
tzdata

# ── Graphics / Wayland ────────────────────────────────────────────────────────
xwayland
mesa-dri-gallium
mesa-vulkan-intel
mesa-vulkan-ati
libdrm
wayland
wayland-protocols

# ── GNOME desktop ─────────────────────────────────────────────────────────────
gnome-shell
gdm
gnome-session
gnome-settings-daemon
gnome-keyring
gnome-control-center
gnome-tweaks
gnome-backgrounds
adwaita-icon-theme
nautilus
gnome-terminal
gvfs
gvfs-fuse
eog
evince

# ── Flatpak / portals ─────────────────────────────────────────────────────────
flatpak
xdg-desktop-portal
xdg-desktop-portal-gnome
xdg-utils
xdg-user-dirs

# ── Audio ─────────────────────────────────────────────────────────────────────
pipewire
pipewire-pulse
pipewire-alsa
wireplumber

# ── Networking ────────────────────────────────────────────────────────────────
networkmanager
networkmanager-wifi
wpa_supplicant
wireless-tools

# ── Fonts ─────────────────────────────────────────────────────────────────────
font-dejavu
font-noto
font-noto-emoji
font-liberation

# ── Installer / boot dependencies ─────────────────────────────────────────────
gptfdisk
dosfstools
e2fsprogs
# systemd-boot provides the bootx64.efi EFI binary for the installed-disk bootloader.
# The binary is copied to the ISO by stage 8; it is NOT used at runtime on Alpine
# (which uses OpenRC, not systemd). Only the EFI file is needed.
systemd-boot

# ── Firmware ──────────────────────────────────────────────────────────────────
linux-firmware
