# larch-os package list — installed via debootstrap second-stage
# Lines starting with # are comments; blank lines are ignored.
# Processed by scripts/setup-chroot.sh

# ── Base / boot ──────────────────────────────────────────────────────────────
linux-image-amd64
systemd
systemd-sysv
udev
dbus
dbus-user-session
libpam-systemd
busybox-static
bash
coreutils
util-linux
procps
findutils
grep
sed
gawk
tar
gzip
bzip2
xz-utils
zstd
iproute2
iputils-ping
less
file
which
mount
kmod
pciutils
usbutils
dmidecode
lsof
strace
vim-tiny
nano
curl
wget
ca-certificates
openssl
login
passwd
adduser
locales

# ── Graphics / Wayland ───────────────────────────────────────────────────────
xwayland
mesa-vulkan-drivers
libgl1-mesa-dri
libgles2
libdrm2
libgbm1
libegl1
libwayland-client0
libwayland-server0

# ── GNOME desktop ────────────────────────────────────────────────────────────
gnome-shell
gdm3
gnome-session
gnome-settings-daemon
gnome-keyring
gnome-control-center
gnome-backgrounds
gnome-themes-extra
adwaita-icon-theme
nautilus
gnome-terminal
gvfs
gvfs-backends
gvfs-fuse
eog
evince
gedit

# ── Boot splash (OEM/firmware logo via BGRT) ─────────────────────────────────
# plymouth shows a graphical splash; the bgrt theme reuses the firmware's
# ACPI BGRT logo (the manufacturer logo) so boot continues that image instead
# of scrolling logs. Started from systemd post-switch_root (sysinit.target).
plymouth
plymouth-themes

# ── Flatpak / portals ────────────────────────────────────────────────────────
flatpak
xdg-desktop-portal
xdg-desktop-portal-gnome
xdg-utils
xdg-user-dirs

# ── Audio ────────────────────────────────────────────────────────────────────
pipewire
pipewire-pulse
pipewire-alsa
wireplumber
libspa-0.2-bluetooth
libspa-0.2-jack

# ── Networking ───────────────────────────────────────────────────────────────
network-manager
libnm0
wpasupplicant
wireless-tools
iw

# ── Fonts ────────────────────────────────────────────────────────────────────
fonts-noto
fonts-noto-color-emoji
fonts-dejavu
fonts-liberation

# ── Installer dependencies ───────────────────────────────────────────────────
# The installer runs in the booted live system (udev loads all drivers), so it
# uses these real tools directly: sfdisk/lsblk/losetup/blkid (util-linux, base),
# mkfs.fat (dosfstools), mkfs.ext4 (e2fsprogs), openssl, and cpio/gzip to wrap
# the recovered squashfs into the target's OS initramfs at install time.
gdisk
dosfstools
e2fsprogs
systemd-boot
cpio

# ── Firmware (broad coverage for common hardware) ────────────────────────────
firmware-linux-free
firmware-linux-nonfree
firmware-iwlwifi
firmware-realtek
firmware-atheros
firmware-brcm80211
firmware-mediatek
