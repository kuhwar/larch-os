#!/bin/sh
# larch-persist-timezone — save the timezone to LARCHCONF.
#
# timedated (GNOME Settings → Date & Time) sets the timezone by replacing the
# /etc/localtime symlink, which lives in the tmpfs overlay and would revert to
# UTC on reboot. Save the zone name to /etc/larch-conf/timezone instead; the OS
# init re-links /etc/localtime from it on every boot. Triggered by
# larch-persist-timezone.path.
set -eu

DEST=/etc/larch-conf/timezone

if ! mountpoint -q /etc/larch-conf; then
    echo "LARCHCONF not mounted at /etc/larch-conf; not persisting" >&2
    exit 0
fi

# timedated writes a relative link (../usr/share/zoneinfo/Europe/Berlin).
target=$(readlink /etc/localtime) || exit 0
tz=${target#*/zoneinfo/}
if [ "$tz" = "$target" ]; then
    echo "unexpected /etc/localtime target: $target" >&2
    exit 1
fi

if [ -f "$DEST" ] && [ "$(cat "$DEST")" = "$tz" ]; then
    exit 0
fi

# Atomic replace (temp file + rename), as in larch-persist-accounts.
_tmp=$(mktemp /etc/larch-conf/.timezone.XXXXXX)
printf '%s\n' "$tz" > "$_tmp"
chmod 0644 "$_tmp"
sync "$_tmp"
mv -f "$_tmp" "$DEST"
sync /etc/larch-conf
echo "persisted timezone $tz"
