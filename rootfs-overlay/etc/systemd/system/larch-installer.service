# larch-os installer — runs the disk installer on tty1 when the ISO is booted.
#
# The ISO's GRUB cmdline carries `larch.installer systemd.unit=multi-user.target`,
# so the live system boots to a text console (no GDM) and this unit takes over
# tty1. Because the system is fully booted, systemd-udevd has already loaded every
# hardware driver (keyboard, storage, …) from the complete module tree in the
# squashfs — the installer no longer depends on a hand-maintained module list, and
# the keyboard works on any machine.
#
# On a NORMAL (installed-disk) boot the cmdline has no `larch.installer`, so the
# ConditionKernelCommandLine below fails and this unit is skipped entirely.
[Unit]
Description=larch-os disk installer
ConditionKernelCommandLine=larch.installer
# Own tty1 instead of a login prompt.
Conflicts=getty@tty1.service
After=systemd-user-sessions.service plymouth-quit-wait.service
After=systemd-udevd.service

[Service]
Type=idle
# Defensive: drop any boot splash so the installer is visible on the console.
ExecStartPre=-/usr/bin/plymouth quit
ExecStart=/usr/sbin/larch-install
# Bind the installer to tty1 so its prompts and password entry read the keyboard.
StandardInput=tty
StandardOutput=tty
StandardError=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
# If the installer aborts to its debug shell, keep the unit alive (don't respawn).
Restart=no

[Install]
WantedBy=multi-user.target
