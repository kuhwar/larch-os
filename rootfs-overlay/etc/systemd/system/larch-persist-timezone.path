# Write timezone changes back to LARCHCONF.
#
# /etc/localtime is a symlink, and inotify follows it to the zoneinfo file on
# the read-only squashfs — so a PathChanged= on it never fires when timedated
# replaces the link. Watch /etc itself instead (any create/rename/write in it);
# runtime writes to /etc are rare, and the service exits early when the saved
# zone is unchanged.
[Unit]
Description=Watch /etc/localtime for timezone changes to persist to LARCHCONF

[Path]
PathChanged=/etc

[Install]
WantedBy=paths.target
