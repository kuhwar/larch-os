// larch-os — the hostname is fixed at install time (<username>-<brand>-<device type>,
// written by the installer into LARCHSYS's /etc/hostname). The root is mounted
// read-only, so a rename via systemd-hostnamed (GNOME Settings → About →
// Device Name, hostnamectl) would fail anyway. Deny all hostnamed
// set-* actions (static/transient/pretty hostname and machine-info) outright;
// GNOME Settings then shows the device name as read-only.
polkit.addRule(function(action, subject) {
    if (action.id.indexOf("org.freedesktop.hostname1.set-") == 0) {
        return polkit.Result.NO;
    }
});
