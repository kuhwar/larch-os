# /etc/fstab — larch-os
# Static and identical on every machine: partitions are found by label, so
# nothing here is per-machine. /tmp is left to systemd's stock tmp.mount.
#
# No initramfs: the kernel mounts LARCHSYS read-only itself
# (root=PARTLABEL=LARCHSYS ro in the loader entry). Every writable path is a
# mount below, and its mount point ships in the image (setup-chroot.sh), since
# nothing can be created on the read-only root at boot.

# LARCHSYS: the OS, read-only.
LABEL=LARCHSYS                          /                                       ext4   ro,noatime                       0  1

# LARCHCONF: persistent, root-owned system config — and all of /var. Not
# nofail: without it /var isn't writable and the system can't come up properly.
LABEL=LARCHCONF                         /etc/larch-conf                         ext4   defaults,relatime                0  2

# /var lives on LARCHCONF (the installer copies the image's /var there), so
# every service's state (NetworkManager, Bluetooth, AccountsService, journal,
# timers, …) persists without per-directory binds. /var/tmp is tmpfs so
# unbounded temp files can't fill LARCHCONF.
/etc/larch-conf/var                     /var                                    none   bind                             0  0
tmpfs                                   /var/tmp                                tmpfs  mode=1777,nosuid,nodev,size=25%  0  0

# LARCHHOME: the user's home lives at /home/<username> on this partition.
LABEL=LARCHHOME                         /home                                   ext4   defaults,relatime,nofail         0  2

# /etc state that must persist: NetworkManager connections and CUPS queues.
/etc/larch-conf/nm-system-connections   /etc/NetworkManager/system-connections  none   bind,nofail                      0  0
/etc/larch-conf/cups                    /etc/cups/larch-state                   none   bind,nofail                      0  0

# udisks mounts removable drives under /media/<user>, which it must create.
tmpfs                                   /media                                  tmpfs  mode=0755,nosuid,nodev           0  0
