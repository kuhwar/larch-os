# /etc/fstab — larch-os
# This is the image-default fstab; the installer writes a per-machine fstab
# (mounted at /home from LABEL=LARCHHOME, plus LARCHCONF and its bind mounts)
# which the OS init applies on every boot, replacing this file.
tmpfs  /tmp     tmpfs  defaults,nosuid,nodev  0  0
tmpfs  /run     tmpfs  defaults,nosuid,nodev  0  0
