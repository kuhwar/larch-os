// larch-os — accounts are managed only from the boot menu (Manage LARCH →
// Manage users: system/updater/manage.sh), never from the running system.
// Deny user administration outright (add/delete users, change account type,
// autologin), along with GNOME Settings' own permission for unlocking those
// controls in the Users panel. Changes to the user's own account (password,
// full name, avatar, language) use the separate change-own-* actions and stay
// allowed.
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.accounts.user-administration" ||
        action.id == "org.gnome.controlcenter.user-accounts.administration") {
        return polkit.Result.NO;
    }
});
