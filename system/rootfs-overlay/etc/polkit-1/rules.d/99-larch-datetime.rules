// larch-os — let the locally-seated active desktop user manage time settings
// (GNOME Settings → System → Date & Time): timezone, network time on/off and
// the clock. They default to auth_admin, but larch-os has no admin identity
// (see 99-larch-cups.rules). Automatic Time Zone also needs set-timezone:
// gsd-datetime calls timedated from the user's session. datetime.configure is
// GNOME Settings' own permission that unlocks the page. timedated's changes
// (the /etc/localtime link, network time on/off) land in /etc's upper layer
// on LARCHCONF, so they persist.
polkit.addRule(function(action, subject) {
    if ((action.id == "org.freedesktop.timedate1.set-timezone" ||
         action.id == "org.freedesktop.timedate1.set-ntp" ||
         action.id == "org.freedesktop.timedate1.set-time" ||
         action.id == "org.gnome.controlcenter.datetime.configure") &&
        subject.local && subject.active) {
        return polkit.Result.YES;
    }
});
