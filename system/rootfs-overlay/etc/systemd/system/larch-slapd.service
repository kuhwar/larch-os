# The local account directory (ldap-poc). Fedora's slapd.service is not used:
# it listens on the network, runs check-config.sh over slapd.d and waits for
# network-online.target.
[Unit]
Description=Local account directory (OpenLDAP)
RequiresMountsFor=/conf/ldap
ConditionPathExists=/conf/ldap/data.mdb
Before=nslcd.service nss-user-lookup.target

[Service]
Type=forking
PIDFile=/run/openldap/slapd.pid
ExecStart=/usr/sbin/slapd -u ldap -g ldap -h ldapi://%%2Frun%%2Fopenldap%%2Fldapi -f /etc/openldap/slapd.conf

[Install]
WantedBy=multi-user.target
