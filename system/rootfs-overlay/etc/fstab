# /etc/fstab — larch-os
# Static and identical on every machine: partitions are found by label, so
# nothing here is per-machine. /tmp is left to systemd's stock tmp.mount.
#
# The root is sys.squashfs on LARCHSYS, loop-mounted read-only by sys.initramfs
# (system/initramfs/sys/init), which also mounts — before systemd starts —
# LARCHCONF at /conf and the binds on /etc and /var:
#
#   /etc = the image's, read-only. Its per-machine files (hostname, hosts,
#          machine-id, localtime, …) are symlinks to /conf/etc/<file>, and
#          LARCHCONF/etc/{cups,bluetooth,X11/xorg.conf.d} are bind-mounted on /etc's
#          (shared/lib/conf.sh ETC_LINKS, ETC_DIRS). PID 1 starts with them
#          already in place. The accounts are in /conf/ldap.
#   /var = the image's, read-only, with LARCHCONF/var/{lib,log,cache,spool}
#          bind-mounted on /var/{lib,log,cache,spool}: every service's state
#          (NetworkManager, Bluetooth, AccountsService, journal, timers, CUPS
#          jobs, …) persists there, and nothing else in /var is writable.
#
# Those lines are listed here only so systemd knows them and orders their
# unmounting at shutdown (the binds before /conf); they are already
# mounted, and /conf has fsck pass 0 because sys.initramfs checks it.
#
# /var/tmp is tmpfs so unbounded temp files can't fill LARCHCONF. LARCHHOME
# holds the user's home at /home/<username>. udisks mounts removable drives
# under /media/<user>, which it must create, hence the tmpfs there. Every mount
# point ships in the image (setup-chroot.sh), since nothing can be created on
# the read-only root at boot.

LABEL=LARCHCONF          /conf       ext4      defaults,relatime                              0  0
/conf/etc/cups           /etc/cups   none      bind,x-systemd.requires-mounts-for=/conf       0  0
/conf/etc/bluetooth      /etc/bluetooth  none  bind,x-systemd.requires-mounts-for=/conf    0  0
/conf/etc/X11/xorg.conf.d  /etc/X11/xorg.conf.d  none  bind,x-systemd.requires-mounts-for=/conf  0  0
/conf/var/lib            /var/lib    none      bind,x-systemd.requires-mounts-for=/conf       0  0
/conf/var/log            /var/log    none      bind,x-systemd.requires-mounts-for=/conf       0  0
/conf/var/cache          /var/cache  none      bind,x-systemd.requires-mounts-for=/conf       0  0
/conf/var/spool          /var/spool  none      bind,x-systemd.requires-mounts-for=/conf       0  0
tmpfs                    /var/tmp    tmpfs     mode=1777,nosuid,nodev,size=25%                0  0
LABEL=LARCHHOME          /home       ext4      defaults,relatime,nofail                       0  2
tmpfs                    /media      tmpfs     mode=0755,nosuid,nodev                         0  0
