# Paths left out of sys.squashfs (stage 6: mksquashfs -wildcards -ef).
# Patterns are relative to the rootfs root; * doesn't match a leading dot,
# so dotfiles need their own .* line; "... <pattern>" matches at any depth.
#
# The mount points themselves stay in the image (nothing can be created on the
# read-only root at boot); only their contents go.

# Build-chroot leftovers, covered at boot by devtmpfs, tmpfs and proc/sysfs.
dev/*
dev/.*
run/*
run/.*
tmp/*
tmp/.*
proc/*
sys/*

# The default user's /home/larch; LARCHHOME is mounted over /home.
home/*
home/.*

# Whatever lands in /boot (nothing on Arch, with mkinitcpio's hooks off): the
# kernel ships as the release's vmlinuz (stage 9) and boots from LARCHEFI.
boot/*
boot/.*

root/.cache

# Arch keeps the kernel image beside its modules; it ships as the release's
# vmlinuz (stage 9, taken from the base), so the images don't need a copy.
usr/lib/modules/*/vmlinuz
