# Files and directories deleted from the rootfs before squashfs (stage 5,
# scripts/clean-rootfs.sh, after the remove.list removal). For things whose
# package must stay (essential, or a dependency of something needed), and for
# build leftovers no package owns.
#
# One absolute path per line, removed recursively (rm -rf); # comments and
# blank lines are ignored. Shell globs are expanded inside the rootfs; a path
# or glob that matches nothing is skipped. Don't list "/" or top-level dirs.
# Logic that a plain list can't express (iwlwifi firmware selection, the
# wallpaper allow-list, chmod) stays in clean-rootfs.sh.

# ── Package manager ──────────────────────────────────────────────────────────
/usr/bin/pacman*
/usr/bin/makepkg*
/usr/bin/repo-add
/usr/bin/repo-elephant
/usr/bin/repo-remove
/usr/bin/vercmp
/usr/bin/testpkg
/usr/lib/libalpm.so*
/usr/share/pacman
/usr/share/makepkg
/usr/share/makepkg-template
/usr/share/libalpm
/var/lib/pacman
/var/cache/pacman
/var/log/pacman.log
/etc/pacman.conf
/etc/pacman.d
/etc/makepkg.conf
/etc/makepkg.conf.d
/etc/makepkg.d

# ── systemd-boot ─────────────────────────────────────────────────────────────
# Part of Arch's systemd package. The bootloader is a release file (stage 9
# takes systemd-bootx64.efi from the base); nothing in the running system
# installs or updates it.
/usr/lib/systemd/boot
/usr/bin/bootctl
/usr/lib/systemd/system/systemd-boot-update.service
/usr/lib/systemd/system/systemd-boot-random-seed.service
/usr/lib/systemd/system/sysinit.target.wants/systemd-boot-random-seed.service

# ── Build leftovers ──────────────────────────────────────────────────────────
/usr/lib/gcc
/usr/include/*
# DKMS sources: nvidia-550xx-dkms and broadcom-wl-dkms built their .ko into
# /usr/lib/modules at stage 4.
/usr/src/*
/var/lib/dkms
/usr/lib/modules/*/build
/usr/lib/modules/*/source
# NVIDIA's X.Org driver and GLX server module (no X server in the image).
/usr/lib/xorg/modules/drivers/nvidia_drv.so
/usr/lib/nvidia/xorg
/usr/bin/nvidia-xconfig

# NVIDIA's compute, ray-tracing and video-codec userspace. The Debian image
# never had it (only the GL/EGL/Vulkan driver), and Flatpak apps bring their
# own NVIDIA userspace (org.freedesktop.Platform.GL.nvidia): on the host only
# gnome-shell/mutter use the driver, through GL/EGL/GBM/Vulkan.
/usr/lib/libcuda.so*
/usr/lib/libcudadebugger.so*
/usr/lib/libnvidia-nvvm.so*
/usr/lib/libnvidia-ptxjitcompiler.so*
/usr/lib/libnvidia-rtcore.so*
/usr/lib/libnvoptix.so*
/usr/share/nvidia/nvoptix.bin
/usr/lib/libnvcuvid.so*
/usr/lib/libnvidia-encode.so*
/usr/lib/libnvidia-opticalflow.so*
/usr/lib/libnvidia-ngx.so*
/usr/bin/nvidia-ngx-updater
/usr/lib/nvidia/wine
/usr/lib/libnvidia-pkcs11*.so*
/etc/OpenCL/vendors/nvidia.icd

# GObject-introspection XML: only for building against a library; at runtime
# GNOME reads the compiled typelibs in /usr/lib/girepository-1.0.
/usr/share/gir-1.0

# ── Docs ─────────────────────────────────────────────────────────────────────
# Translations (/usr/share/locale) and translated GNOME help are kept: every
# language is selectable. /usr/share/i18n is only the source data locale-gen
# compiles from (setup-chroot.sh already compiled every locale into
# /usr/lib/locale/locale-archive).
/usr/share/doc
/usr/share/man
/usr/share/info
/usr/share/gtk-doc
/usr/share/i18n

# ── Setuid/setgid helpers with no job on this design ─────────────────────────
# Their packages (util-linux, shadow, polkit, gstreamer) are depended on.
# Kept: passwd (GNOME Settings runs it as the user), unix_chkpwd (lock screen),
# dbus-daemon-launch-helper (polkit-agent-helper-1 is a socket service, not setuid),
# fusermount3 (AppImage, gvfs, document portal), newuidmap/newgidmap (file
# capabilities; rootless Podman), nvidia-modprobe (CUDA loads nvidia-uvm on
# demand). mount/umount lose setuid in clean-rootfs.sh.
# su: root is locked; the only other account is the user's own.
/usr/bin/su
/etc/pam.d/su
/etc/pam.d/su-l
# pkexec: runs programs as root after admin authentication; there is no admin.
/usr/bin/pkexec
# chfn: GNOME renames via AccountsService (usermod, as root).
/usr/bin/chfn
/etc/pam.d/chfn
# chsh: bash is the only shell, and none can be installed.
/usr/bin/chsh
/etc/pam.d/chsh
# gpasswd, newgrp/sg: group administration and switching; no group has a
# password or administrators.
/usr/bin/gpasswd
/usr/bin/newgrp
/usr/bin/sg
# chage, expiry: password ageing; nothing uses it.
/usr/bin/chage
/usr/bin/expiry
# GStreamer's PTP clock helper (file capabilities, for AES67 network audio).
/usr/lib/gstreamer-1.0/gst-ptp-helper

# ── SSH server (no remote shell on larch-os) ─────────────────────────────────
# Arch's openssh is one package (client + server), and GNOME's gcr depends on
# it for ssh-agent integration. The client and ssh-agent stay; sshd, its
# helpers and units go, as does setuid ssh-keysign (host-based auth).
/usr/bin/sshd
/usr/lib/ssh/sshd-auth
/usr/lib/ssh/sshd-session
/usr/lib/ssh/sftp-server
/usr/lib/ssh/ssh-keysign
/usr/lib/systemd/system/sshd.service
/usr/lib/systemd/system/sshd@.service
/usr/lib/systemd/system/sshd.socket
/usr/lib/systemd/system/sshdgenkeys.service
/etc/ssh/sshd_config
/etc/ssh/sshd_config.d
/etc/pam.d/sshd

# ksu (krb5, setuid): Kerberos su; root is locked.
/usr/bin/ksu

# ── Tools dependencies drag in that can't run here or have no use ────────────
# v4l-utils (via gst-plugins-good): Qt test tools, and there is no Qt.
/usr/bin/qv4l2
/usr/bin/qvidcap
/usr/share/applications/qv4l2.desktop
/usr/share/applications/qvidcap.desktop
# HPLIP's GUIs need PyQt, which isn't installed; the CUPS backend/driver stay.
/usr/share/applications/hplip.desktop
/usr/share/applications/hp-uiscan.desktop
/etc/xdg/autostart/hplip-systray.desktop
# CUPS's web-interface launcher (GNOME Settings manages printers).
/usr/share/applications/cups.desktop
# hwloc (via appstream's onetbb): the library stays, its viewer goes.
/usr/bin/lstopo
/usr/share/applications/lstopo.desktop

# Language bindings whose runtime only an optional dependency provides, which
# orphan removal (clean-rootfs.sh) takes out: Imath's Python bindings (boost's
# libboost_python; via openexr <- libvips <- appstream <- flatpak) and
# Graphviz's Guile binding (via libmediainfo <- localsearch <- nautilus).
# Nothing in the image loads either; the library guard demands they go too.
/usr/lib/libPyImath*.so*
/usr/lib/python3.*/site-packages/imath*.so
/usr/lib/graphviz/guile

# ── GUI bits of system-config-printer ────────────────────────────────────────
# Only its D-Bus service (org.fedoraproject.Config.Printing) is needed, by
# GNOME Settings' Printers panel.
/usr/share/applications/system-config-printer.desktop
/etc/xdg/autostart/print-applet.desktop

# ── Firmware for hardware that's never in a PC ───────────────────────────────
# Kept on purpose: ti/ (TAS2781-family laptop amplifiers) and nxp/ (BT/Wi-Fi
# modules). Dangling compatibility symlinks are cleaned up by clean-rootfs.sh.
# Names match with or without Arch's .zst suffix.
# MediaTek Filogic router/AP SoCs and cards.
/usr/lib/firmware/mediatek/mt7622*
/usr/lib/firmware/mediatek/mt7981*
/usr/lib/firmware/mediatek/mt7986*
/usr/lib/firmware/mediatek/mt7987
/usr/lib/firmware/mediatek/mt7988
/usr/lib/firmware/mediatek/mt7996
# MediaTek mt81xx ARM Chromebook SoCs, incl. their SOF audio DSP.
/usr/lib/firmware/mediatek/mt81*
/usr/lib/firmware/mediatek/sof
/usr/lib/firmware/mediatek/sof-tplg
# Qualcomm router/AP chips and Snapdragon SoC Wi-Fi.
/usr/lib/firmware/ath10k/QCA4019
/usr/lib/firmware/ath10k/QCA9888
/usr/lib/firmware/ath10k/QCA9984
/usr/lib/firmware/ath10k/QCA99X0
/usr/lib/firmware/ath10k/WCN3990
/usr/lib/firmware/ath11k/IPQ*
/usr/lib/firmware/ath11k/QCN*
/usr/lib/firmware/ath11k/WCN6750
/usr/lib/firmware/ath12k/IPQ*
/usr/lib/firmware/ath12k/QCN*
# Arm Mali GPUs, Chips&Media codecs (ARM SoCs), Chelsio server NICs, Tegra.
/usr/lib/firmware/arm
/usr/lib/firmware/cnm
/usr/lib/firmware/cxgb4
/usr/lib/firmware/nvidia/tegra*

# ── Temporary files and logs from the build ──────────────────────────────────
/tmp/*
/var/tmp/*
/var/log/*.log
/var/log/*.gz
/root/.bash_history
/home/*/.bash_history
