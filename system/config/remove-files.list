# Files and directories deleted from each desktop's rootfs before squashfs
# (stage 5, scripts/clean-rootfs.sh, after remove.list and the orphans). For
# things whose package must stay, and for leftovers no package owns.
#
# One absolute path per line, removed recursively (rm -rf); # comments and
# blank lines are ignored. Shell globs are expanded inside the rootfs; a path
# or glob that matches nothing is skipped. Don't list "/" or top-level dirs.

# ── Package databases ────────────────────────────────────────────────────────
/usr/lib/sysimage/rpm
/usr/lib/sysimage/libdnf5
/var/lib/rpm
/var/lib/dnf
/var/cache/dnf
/var/cache/libdnf5
/var/cache/akmods
/etc/dnf
/etc/yum.repos.d
/etc/distro.repos.d
/var/log/dnf*

# ── Fedora's own Flatpak remote ──────────────────────────────────────────────
# Fedora's flatpak package adds the Fedora (OCI) remote at boot; larch's only
# remote is Flathub (rootfs-overlay/etc/flatpak/remotes.d).
/usr/lib/systemd/system/flatpak-add-fedora-repos.service
/etc/systemd/system/*.target.wants/flatpak-add-fedora-repos.service

# ── systemd-boot (systemd-udev's part of it) ─────────────────────────────────
/usr/bin/bootctl
/usr/lib/systemd/system/systemd-boot-update.service
/usr/lib/systemd/system/systemd-boot-random-seed.service
/usr/lib/systemd/system/sysinit.target.wants/systemd-boot-random-seed.service

# ── Development leftovers ────────────────────────────────────────────────────
/usr/include/*
/usr/share/gir-1.0
/usr/lib/modules/*/build
/usr/lib/modules/*/source
/usr/src/*

# ── NVIDIA: compute, ray-tracing and video-codec userspace ───────────────────
# The Debian image never had it (only the GL/EGL/Vulkan driver), and Flatpak
# apps bring their own NVIDIA userspace (org.freedesktop.Platform.GL.nvidia):
# on the host only gnome-shell/mutter use the driver, through GL/EGL/GBM/Vulkan.
/usr/lib64/libcuda.so*
# libnvidia-present links libcuda; nothing links it, and no GL/EGL/Vulkan
# vendor file names it.
/usr/lib64/libnvidia-present.so*
/usr/lib64/libcudadebugger.so*
/usr/lib64/libnvidia-nvvm.so*
/usr/lib64/libnvidia-nvvm70.so*
/usr/lib64/libnvidia-ptxjitcompiler.so*
/usr/lib64/libnvidia-rtcore.so*
/usr/lib64/libnvoptix.so*
/usr/share/nvidia/nvoptix.bin
/usr/lib64/libnvcuvid.so*
/usr/lib64/libnvidia-encode.so*
/usr/lib64/libnvidia-opticalflow.so*
/usr/lib64/libnvidia-opencl.so*
/etc/OpenCL/vendors/nvidia.icd
/usr/lib64/libnvidia-ngx.so*
/usr/bin/nvidia-ngx-updater
/usr/lib64/nvidia/wine
/usr/lib64/libnvidia-pkcs11*.so*

# ── NVIDIA: X.Org driver bits (there is no X server) ─────────────────────────
/usr/lib64/xorg/modules/drivers/nvidia_drv.so
/usr/lib64/nvidia/xorg
/usr/bin/nvidia-xconfig

# ── Vulkan drivers that never apply on a PC ──────────────────────────────────
# lvp = software Vulkan; gfxstream/virtio = VM-guest-only; Asahi (Apple
# Silicon), Freedreno (Qualcomm), PowerVR, Panfrost/Broadcom (ARM SoCs).
/usr/lib64/libvulkan_lvp.so
/usr/lib64/libvulkan_gfxstream.so
/usr/lib64/libvulkan_virtio.so
/usr/lib64/libvulkan_asahi.so
/usr/lib64/libvulkan_freedreno.so
/usr/lib64/libvulkan_powervr_mesa.so
/usr/lib64/libvulkan_panfrost.so
/usr/lib64/libvulkan_broadcom.so
# NVK (nouveau's Vulkan): the NVIDIA packages blacklist nouveau, so it never loads.
/usr/lib64/libvulkan_nouveau.so
/usr/share/vulkan/icd.d/nouveau_icd*.json
/usr/share/vulkan/icd.d/lvp_icd*.json
/usr/share/vulkan/icd.d/gfxstream*_icd*.json
/usr/share/vulkan/icd.d/virtio_icd*.json
/usr/share/vulkan/icd.d/asahi_icd*.json
/usr/share/vulkan/icd.d/freedreno_icd*.json
/usr/share/vulkan/icd.d/powervr_mesa_icd*.json
/usr/share/vulkan/icd.d/panfrost_icd*.json
/usr/share/vulkan/icd.d/broadcom_icd*.json

# ── Docs (tsflags=nodocs skips most; these come from %license, scriptlets) ───
# Translations (/usr/share/locale) and translated GNOME help are kept.
/usr/share/doc
/usr/share/man
/usr/share/info
/usr/share/gtk-doc
/usr/share/licenses

# ── Setuid/setgid helpers with no job on this design ─────────────────────────
# Kept: passwd (GNOME Settings runs it as the user), unix_chkpwd (lock screen),
# dbus-daemon-launch-helper, fusermount3 (AppImage, gvfs, document portal),
# newuidmap/newgidmap (rootless Podman), nvidia-modprobe (CUDA loads
# nvidia-uvm on demand). mount/umount lose setuid in clean-rootfs.sh.
/usr/bin/su
/etc/pam.d/su
/etc/pam.d/su-l
/usr/bin/pkexec
/usr/bin/chfn
/etc/pam.d/chfn
/usr/bin/chsh
/etc/pam.d/chsh
/usr/bin/gpasswd
/usr/bin/newgrp
/usr/bin/sg
/usr/bin/chage
# pam_timestamp_check: sudo's timestamp helper; lockdev (setgid lock): serial
# device locking nothing here does.
/usr/bin/pam_timestamp_check
/usr/bin/lockdev
/usr/libexec/gstreamer-1.0/gst-ptp-helper
/usr/lib64/gstreamer-1.0/gst-ptp-helper

# ── Firmware for hardware that's never in a PC ───────────────────────────────
# Kept on purpose: ti/ (TAS2781-family laptop amplifiers) and nxp/ (BT/Wi-Fi
# modules). Dangling compatibility symlinks are cleaned up by setup-chroot.sh.
/usr/lib/firmware/mediatek/mt7622*
/usr/lib/firmware/mediatek/mt7981*
/usr/lib/firmware/mediatek/mt7986*
/usr/lib/firmware/mediatek/mt7987
/usr/lib/firmware/mediatek/mt7988
/usr/lib/firmware/mediatek/mt7996
/usr/lib/firmware/mediatek/mt81*
/usr/lib/firmware/mediatek/sof
/usr/lib/firmware/mediatek/sof-tplg
/usr/lib/firmware/ath10k/QCA4019
/usr/lib/firmware/ath10k/QCA9888
/usr/lib/firmware/ath10k/QCA9984
/usr/lib/firmware/ath10k/QCA99X0
/usr/lib/firmware/ath10k/WCN3990
/usr/lib/firmware/ath11k/IPQ*
/usr/lib/firmware/ath11k/QCN*
/usr/lib/firmware/ath11k/WCN6750
/usr/lib/firmware/ath12k/IPQ*
/usr/lib/firmware/ath12k/QCN*
/usr/lib/firmware/arm
/usr/lib/firmware/cnm
/usr/lib/firmware/cxgb4
/usr/lib/firmware/nvidia/tegra*

# ── Temporary files and logs from the build ──────────────────────────────────
/tmp/*
/var/tmp/*
/var/log/*.log
/root/.bash_history
/home/*/.bash_history
