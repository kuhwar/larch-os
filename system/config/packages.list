# larch-os BASE package list — what every desktop image has
# Lines starting with # are comments; blank lines are ignored.
# Installed by system/build.sh (stage 4) with the builder's dnf into the base
# rootfs: weak dependencies (Recommends) are never installed and docs never
# extracted, so everything the image needs is listed here. The out-of-tree
# kernel modules and their userspace are in akmods.list; desktop environments
# add their own packages in system/desktops/<desktop>/packages.list.

# ── Release identity & kernel ────────────────────────────────────────────────
# generic-release/-logos: Fedora's trademark guidelines want derivatives
# unbranded. kernel-modules-extra: the less common drivers (the installer and
# updater carry every disk and network driver the kernel has).
generic-release
generic-logos
kernel-core
kernel-modules
kernel-modules-core
kernel-modules-extra

# ── Base system ──────────────────────────────────────────────────────────────
systemd
systemd-udev
# pam_systemd: registers logins with logind, which starts the user's systemd
# and session bus. Without it GDM's greeter has no bus ("Unable to run session
# message bus") and the screen stays black. Fedora's PAM stack loads it with
# "-session", so its absence is otherwise silent.
systemd-pam
dbus-broker
bash
coreutils
util-linux
procps-ng
findutils
grep
sed
gawk
tar
gzip
bzip2
xz
zstd
iproute
iputils
less
file
which
kmod
pciutils
usbutils
dmidecode
nano
curl
ca-certificates
openssl
# passwd, useradd, newuidmap/newgidmap (rootless containers)
shadow-utils
authselect
# Dictionary for libpwquality — without it GNOME Settings rejects every password
cracklib-dicts
libpwquality
# Every locale, precompiled (selectable in GNOME Settings)
glibc-all-langpacks
tzdata

# ── Graphics / Wayland ───────────────────────────────────────────────────────
mesa-dri-drivers
mesa-vulkan-drivers
mesa-libEGL
mesa-libgbm
libglvnd-egl
xorg-x11-server-Xwayland

# ── Boot splash (OEM/firmware logo via BGRT) ─────────────────────────────────
plymouth
plymouth-scripts
plymouth-theme-spinner

# ── Flatpak / portals ────────────────────────────────────────────────────────
flatpak
# flatpak verifies remotes' GPG signatures with gpg (only a weak dependency):
# without it Flathub can't be added and nothing installs from it.
gnupg2
xdg-desktop-portal
xdg-utils
xdg-user-dirs

# ── AppImage (libfuse.so.2 + setuid fusermount3) ─────────────────────────────
# libfuse.so.2 mounts by exec'ing `fusermount`; rootfs-overlay/usr/bin/fusermount
# links it to fuse3's setuid fusermount3 (same protocol), as Debian's fuse3 does,
# instead of a second setuid helper from Fedora's fuse package.
fuse-libs
fuse3

# ── Audio ────────────────────────────────────────────────────────────────────
pipewire
pipewire-pulseaudio
pipewire-alsa
wireplumber

# ── Networking ───────────────────────────────────────────────────────────────
NetworkManager
NetworkManager-wifi
wpa_supplicant
iw
# ssh/scp/sftp/ssh-agent/ssh-keygen — client only: no sshd ships
# (rootfs-overlay/etc/polkit-1/rules.d/99-larch-ssh.rules)
openssh-clients

# ── Time (chrony: Fedora's NTP client; timedated finds it for GNOME's
#    "Automatic Date & Time") and location (GNOME's automatic time zone) ──────
chrony
geoclue2

# ── Bluetooth ────────────────────────────────────────────────────────────────
bluez

# ── Printing ─────────────────────────────────────────────────────────────────
# Driverless (IPP Everywhere/AirPrint) via cups-filters, Gutenprint for older
# printers; cups-pk-helper for GNOME Settings' Printers panel, avahi/nss-mdns
# for discovery, ipp-usb for IPP-over-USB, system-config-printer-libs for the
# D-Bus service GNOME Settings uses when adding a printer.
cups
cups-filters
gutenprint-cups
cups-pk-helper
avahi
nss-mdns
ipp-usb
system-config-printer-libs

# ── Fonts ────────────────────────────────────────────────────────────────────
google-noto-sans-vf-fonts
google-noto-serif-vf-fonts
google-noto-sans-mono-vf-fonts
google-noto-color-emoji-fonts
dejavu-sans-fonts
dejavu-sans-mono-fonts
liberation-sans-fonts
liberation-serif-fonts
liberation-mono-fonts

# ── Initramfs build dependencies ─────────────────────────────────────────────
# The installer, updater and sys initramfs are assembled from this rootfs
# (shared/build-lib.sh): busybox (static), dialog, mkfs.fat (dosfstools),
# mkfs.ext4 and e2fsck (e2fsprogs), sfdisk/wipefs (util-linux), kmod, curl and
# wpa_supplicant (above). systemd-boot-unsigned: stage 9 publishes its
# systemd-bootx64.efi as the release file BOOTX64.EFI (remove.list drops it
# from the images).
busybox
dialog
dosfstools
e2fsprogs
systemd-boot-unsigned

# ── Firmware ─────────────────────────────────────────────────────────────────
linux-firmware
amd-gpu-firmware
intel-gpu-firmware
iwlwifi-mvm-firmware
iwlwifi-dvm-firmware
realtek-firmware
atheros-firmware
brcmfmac-firmware
mt7xxx-firmware
alsa-sof-firmware
cirrus-audio-firmware

# ── GPU switching / NVIDIA suspend helpers ───────────────────────────────────
# switcheroo-control: GNOME Settings' "Graphics" row; kbd: chvt for nvidia-sleep.sh
switcheroo-control
kbd
