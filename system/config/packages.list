# larch-os BASE package list — what every desktop image has
# Lines starting with # are comments; blank lines are ignored.
# Processed by scripts/setup-chroot.sh (system stage 4) with `pacman -S
# --needed`, from the Arch snapshot pinned in config/arch-snapshot (stage 2
# already installed `base`). pacman never installs optional dependencies, so
# everything the image needs is listed. Desktop environments add their own
# packages in system/desktops/<desktop>/packages.list.

# ── Kernel ───────────────────────────────────────────────────────────────────
# Arch's mainline kernel. Its headers are needed for DKMS (broadcom-wl-dkms,
# and the NVIDIA 550 driver setup-chroot.sh builds from the AUR); they and the
# toolchain are removed again at stage 5 (remove.list). `linux` rather than
# `linux-lts` because the AUR nvidia-550xx-dkms carries its patches for the
# current mainline kernel. The kernel's mkinitcpio hooks are disabled
# (setup-chroot.sh): every larch initramfs is built by hand.
linux
linux-headers

# ── Base / boot ──────────────────────────────────────────────────────────────
# `base` (stage 2) brings systemd, glibc, coreutils, util-linux, shadow,
# procps-ng, iproute2, iputils, pciutils, findutils, grep, sed, gawk, tar,
# gzip, bzip2, xz, file, …
busybox
kmod
usbutils
dmidecode
lsof
strace
less
which
nano
vi
curl
wget
ca-certificates
openssl
zstd
# Dictionary for libpwquality — without it GNOME Settings rejects every password
cracklib
libpwquality

# ── Graphics / Wayland ───────────────────────────────────────────────────────
# Arch splits Mesa's Vulkan drivers per vendor; only the PC GPUs are listed
# (no lavapipe, virtio, Asahi, Freedreno).
xorg-xwayland
mesa
vulkan-radeon
vulkan-intel
vulkan-nouveau
vulkan-icd-loader
libglvnd
wayland

# ── Boot splash (OEM/firmware logo via BGRT) ─────────────────────────────────
# plymouth shows a graphical splash; the bgrt theme reuses the firmware's
# ACPI BGRT logo (the manufacturer logo) so boot continues that image instead
# of scrolling logs. Started from systemd post-switch_root (sysinit.target).
plymouth

# ── Flatpak / portals ────────────────────────────────────────────────────────
flatpak
xdg-desktop-portal
xdg-utils
xdg-user-dirs

# ── AppImage ─────────────────────────────────────────────────────────────────
# AppImages are self-mounting executables the user keeps in /home. Most embed
# the classic type-2 runtime, which dlopen()s libfuse.so.2 (fuse2); the setuid
# fusermount3 comes from fuse3.
fuse2
fuse3

# ── Rootless containers ──────────────────────────────────────────────────────
# Podman itself is not in the image — the user installs a static build into
# ~/.local. newuidmap/newgidmap (file capabilities, not setuid, on Arch) come
# with `shadow` in base; they map the user's /etc/subuid + /etc/subgid range.

# ── Audio ────────────────────────────────────────────────────────────────────
# pipewire-audio: PipeWire's audio support incl. the Bluetooth (bluez5) codecs.
pipewire
pipewire-audio
pipewire-pulse
pipewire-alsa
pipewire-jack
wireplumber

# ── Networking ───────────────────────────────────────────────────────────────
networkmanager
wpa_supplicant
wireless_tools
iw

# ── Time ─────────────────────────────────────────────────────────────────────
# systemd-timesyncd is part of systemd (enabled in setup-chroot.sh). geoclue:
# the location service gsd-datetime uses for "Automatic Time Zone".
geoclue

# ── Bluetooth ────────────────────────────────────────────────────────────────
bluez

# ── Printing ─────────────────────────────────────────────────────────────────
# cups + cups-filters; broad driver coverage (gutenprint, foomatic, HPLIP)
# in place of Debian's printer-driver-all (splix is AUR-only). cups-pk-helper: polkit-
# mediated admin actions for GNOME Settings' Printers panel (see
# rootfs-overlay/etc/polkit-1/rules.d/99-larch-cups.rules). avahi: DNS-SD
# discovery of network/AirPrint printers. ipp-usb: driverless IPP-over-USB.
# system-config-printer: GNOME Settings talks to its D-Bus service
# (org.fedoraproject.Config.Printing) when adding a printer.
cups
cups-filters
cups-pk-helper
ghostscript
gutenprint
foomatic-db-engine
foomatic-db
foomatic-db-ppds
hplip
avahi
ipp-usb
system-config-printer

# ── Fonts ────────────────────────────────────────────────────────────────────
noto-fonts
noto-fonts-cjk
noto-fonts-emoji
ttf-dejavu
ttf-liberation

# ── Initramfs build dependencies ─────────────────────────────────────────────
# The installer, updater and sys initramfs are assembled from this rootfs
# (shared/build-lib.sh): mkfs.fat (dosfstools), mkfs.ext4 and e2fsck
# (e2fsprogs), sfdisk/wipefs (util-linux), kmod, busybox, curl and
# wpa_supplicant (listed above). systemd-bootx64.efi (the release file
# BOOTX64.EFI) is part of the systemd package; remove-files.list drops it from
# the images. dialog drives the installer's and the updater's UI.
dosfstools
e2fsprogs
dialog

# ── Firmware (broad coverage for common hardware) ────────────────────────────
# linux-firmware pulls in every vendor split (intel, amdgpu, radeon, nvidia,
# realtek, atheros, broadcom, mediatek, …). sof-firmware: Intel SOF audio DSPs
# (most laptops from 2019 on have no sound without it).
linux-firmware
sof-firmware

# ── NVIDIA proprietary driver (Pascal and newer) — pinned to 550 ─────────────
# NOT listed here: setup-chroot.sh builds nvidia-550xx-utils + -dkms from the
# AUR at the commit pinned there (Arch's own nvidia packages are 590+, which
# dropped Pascal). These are what it needs beyond the AUR packages:
#   dkms               — builds nvidia.ko against `linux-headers` (and wl.ko)
#   egl-wayland        — EGL Wayland platform (a dependency of nvidia-utils)
#   switcheroo-control — D-Bus GPU inventory; GNOME Settings' "Graphics" row
#   kbd                — fgconsole/chvt, called by nvidia-sleep.sh
dkms
egl-wayland
switcheroo-control
kbd

# ── Broadcom BCM4360 WiFi (2015 MacBook Air) ─────────────────────────────────
# BCM4360 (14e4:43a0) has no open-source driver. broadcom-wl-dkms provides the
# proprietary wl.ko, built by DKMS at stage 4 against linux-headers.
broadcom-wl-dkms
