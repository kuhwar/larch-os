# Packages removed from each desktop's rootfs AFTER configuration, before
# squashfs (stage 5, scripts/clean-rootfs.sh: one `pacman -Rddn --noscriptlet`
# with every pacman hook disabled; pacman itself is wiped right after via
# remove-files.list).
#
# One package per line; # comments and blank lines are ignored.
#   - Shell globs are allowed (matched against `pacman -Qq`).
#   - A line starting with ! keeps the packages it matches, even if another
#     line matched them.
#   - Names/globs that match nothing installed are ignored.
# For files that belong to packages that must stay, see remove-files.list.
#
# Much shorter than Debian's: pacman never installs optional dependencies, so
# SANE (colord-sane), onnxruntime, desktop branding, cron, … never arrive.

# ── Package manager helpers (pacman's own files: remove-files.list) ──────────
pacman-mirrorlist
archlinux-keyring

# No privilege escalation on the immutable OS — root is locked and there is no
# admin path. (base-devel pulls sudo in for the AUR build.)
sudo

# ── Build toolchain ──────────────────────────────────────────────────────────
# Needed only at stage 4: DKMS (nvidia-550xx-dkms, broadcom-wl-dkms) and the
# AUR build (base-devel, git, patchelf). The built .ko files stay in
# /usr/lib/modules/*/updates/dkms.
base-devel
dkms
gcc
make
patch
autoconf
automake
binutils
bison
debugedit
fakeroot
flex
m4
libtool
pkgconf
texinfo
groff
git
patchelf
linux-headers
# gcc's runtime libraries (libgcc_s, libstdc++) are separate packages.
!gcc-libs
!libgcc
!libstdc++

# mkinitcpio (the kernel's `initramfs` dependency). Every larch initramfs is
# assembled by hand from busybox (shared/build-lib.sh); plymouth runs from the
# real root. Its pacman hooks are disabled in setup-chroot.sh.
mkinitcpio
mkinitcpio-busybox

# perl stays: foomatic-db-engine and HPLIP (printing) run perl scripts.
