# larch-os GSettings defaults (compiled by glib-compile-schemas in
# scripts/clean-rootfs.sh). The user can still change them in GNOME Settings.

# Set the timezone automatically from the location (gsd-datetime + geoclue);
# GNOME requires Location Services for it, so enable those too.
[org.gnome.desktop.datetime]
automatic-timezone=true

[org.gnome.system.location]
enabled=true

# Dark style by default.
[org.gnome.desktop.interface]
color-scheme='prefer-dark'

# The one wallpaper the image ships (/usr/share/backgrounds/larch), for both
# styles and the lock screen.
[org.gnome.desktop.background]
picture-uri='file:///usr/share/backgrounds/larch/larch.jpg'
picture-uri-dark='file:///usr/share/backgrounds/larch/larch.jpg'
picture-options='zoom'

[org.gnome.desktop.screensaver]
picture-uri='file:///usr/share/backgrounds/larch/larch.jpg'
picture-options='zoom'

# No distribution logo on the login screen.
[org.gnome.login-screen]
logo=''

# The dash: Files and Sawmill, the app manager (Fedora's default lists apps
# the image doesn't ship).
[org.gnome.shell]
favorite-apps=['org.gnome.Nautilus.desktop', 'io.sawmill.Store.desktop']

# Folders before files: Files ("Sort Folders Before Files") and GTK 4's file
# chooser share this key; GTK 3 apps' file chooser has its own.
[org.gtk.gtk4.Settings.FileChooser]
sort-directories-first=true

[org.gtk.Settings.FileChooser]
sort-directories-first=true
