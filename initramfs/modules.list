# Shared kernel modules list for both the OS and installer initramfs.
#
# IMPORTANT: names here are matched against .ko FILENAMES (not modprobe aliases).
# The build does find -name "${mod}.ko*" — an exact glob match. Many kernel modules
# use hyphens in their filenames even though modprobe accepts underscores (it
# normalises them). Use the hyphenated filename that matches the actual .ko file.
# Wrong: nvme_core → finds nothing (file is nvme-core.ko)
# Right: nvme-core → finds nvme-core.ko  ✓

# ── Filesystems ───────────────────────────────────────────────────────────────
squashfs
loop
overlay
# isofs is the actual .ko filename; iso9660 is only a modprobe alias
isofs
fat
vfat
nls_utf8
nls_cp437
nls_ascii
# ext4 deps must be listed explicitly so the build copies them into the initramfs
crc16
crc32c_generic
mbcache
jbd2
ext4
# cdrom must precede sr_mod (sr_mod depends on it); sr_mod creates /dev/sr0
cdrom
sr_mod

# ── VirtIO block (QEMU/KVM) ───────────────────────────────────────────────────
virtio
virtio_ring
virtio_pci_legacy_dev
virtio_pci_modern_dev
virtio_pci
virtio_blk
virtio_scsi
scsi_common
scsi_mod

# ── SATA / AHCI ───────────────────────────────────────────────────────────────
libata
libahci
ahci
ata_piix

# ── NVMe ──────────────────────────────────────────────────────────────────────
# nvme-core.ko and nvme-auth.ko use hyphens (not underscores).
# nvme.ko depends on nvme-core.ko which depends on nvme-auth.ko.
nvme-auth
nvme-core
nvme

# ── USB (host controllers + storage) ──────────────────────────────────────────
# Host controller files all use hyphens: xhci-hcd.ko, xhci-pci.ko, etc.
# ehci-pci.ko depends on ehci-hcd.ko, so both must be listed.
usb-common
usbcore
sd_mod
usb-storage
uas
xhci-hcd
xhci-pci
ehci-hcd
ehci-pci
uhci-hcd

# ── Input (keyboard) ──────────────────────────────────────────────────────────
# USB keyboards need the HID stack; hid + hid-generic are loadable modules
# (not built-in). PS/2 keyboards work without these (i8042/atkbd are built-in).
hid
usbhid
hid-generic
hid-apple
evdev
