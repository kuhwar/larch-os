# Kernel modules for the installer initramfs.
# Goal: reach the TARGET disk and write the (baked-in) OS payload to it.
# The OS payload is embedded in this initramfs — there is no ISO to read — so no
# isofs/loop/squashfs/overlay here, only storage controllers + FAT32/ext4.

# ── Filesystem support (target disk: FAT32 boot + ext4 home) ──────
# NLS provides the codepages vfat decodes FAT filenames with.
nls_utf8
nls_cp437
nls_ascii

# ── Virtio core — must load BEFORE virtio_blk / virtio_scsi ──────
virtio
virtio_ring
virtio_pci_legacy_dev
virtio_pci_modern_dev
virtio_pci

# ── NVMe ─────────────────────────────────────────────────────────
nvme_core
nvme

# ── SCSI core — must load BEFORE sd_mod / virtio_scsi ───────────
scsi_common
scsi_mod

# ── Storage drivers (SATA / USB / virtio — reach the target disk) ─
virtio_blk
virtio_scsi
libata
libahci
ahci
ata_piix
sd_mod
uas
usb_storage

# ── USB host controllers ──────────────────────────────────────────
xhci_hcd
xhci_pci
ehci_pci
uhci_hcd

# ── Input (emergency shell) ───────────────────────────────────────
usbhid
hid_generic
evdev

# ── Target disk filesystems (needed to mount partitions after formatting) ─────
vfat
fat
crc16
mbcache
jbd2
# crc32c provides the "crc32c" crypto alg that ext4 loads on demand for metadata
# checksums (mke2fs enables metadata_csum by default). It is NOT listed in ext4's
# modules.dep because it is a runtime crypto-API soft dep — without it, ext4
# registers but mount() fails with "Cannot load crc32c driver".
crc32c_generic
ext4
