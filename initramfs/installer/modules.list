# Kernel modules for the installer initramfs.
# Goal: find and mount the ISO, loop-mount squashfs, set up overlayfs.
# No FAT, no ext4, no NVMe — none of those are needed to read an optical drive.

# ── Filesystem support ────────────────────────────────────────────
isofs
squashfs
overlay
loop
exfat

# NLS required for isofs filename decoding
nls_utf8
nls_cp437
nls_ascii

# ── Virtio core — must load BEFORE virtio_blk / virtio_scsi ──────
virtio
virtio_ring
virtio_pci_legacy_dev
virtio_pci_modern_dev
virtio_pci

# ── NVMe ─────────────────────────────────────────────────────────
nvme_core
nvme

# ── SCSI core — must load BEFORE sr_mod / sd_mod / virtio_scsi ───
scsi_common
scsi_mod

# ── Optical + storage drivers ─────────────────────────────────────
virtio_blk
virtio_scsi
libata
libahci
ahci
ata_piix
cdrom
sr_mod
sd_mod
uas
usb_storage

# ── USB host controllers ──────────────────────────────────────────
xhci_hcd
xhci_pci
ehci_pci
uhci_hcd

# ── Input (emergency shell) ───────────────────────────────────────
usbhid
hid_generic
evdev

# ── Target disk filesystems (needed to mount partitions after formatting) ─────
vfat
fat
crc16
mbcache
jbd2
# crc32c provides the "crc32c" crypto alg that ext4 loads on demand for metadata
# checksums (mke2fs enables metadata_csum by default). It is NOT listed in ext4's
# modules.dep because it is a runtime crypto-API soft dep — without it, ext4
# registers but mount() fails with "Cannot load crc32c driver".
crc32c_generic
ext4
