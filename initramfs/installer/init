#!/bin/sh
# larch-os installer initramfs init — PID 1
#
# Self-contained boot sequence:
#   load target-disk storage modules → exec /install.sh
#
# Everything the installer needs — install.sh AND the entire OS payload
# (kernel, OS initramfs, EFI binary, loader config) — is baked directly into
# this initramfs at /payload. There is NO ISO to find or mount: GRUB loads this
# initramfs into RAM, so the payload is already present regardless of the boot
# medium (optical, dd'd USB, Ventoy, …). When install.sh finishes it calls
# reboot -f.
set -e

log()  { echo "[larch-installer] $*" > /dev/console; }
die()  { echo "[larch-installer] FATAL: $*" > /dev/console; emergency_shell; }

emergency_shell() {
    log "Emergency shell — type 'exit' to attempt to continue"
    exec sh < /dev/console > /dev/console 2>&1
}

load_mod() {
    modprobe "$1" 2>/dev/null && log "  [mod] $1" || log "  [mod] SKIP: $1"
}

# ── Early setup ───────────────────────────────────────────────────────────────

mount -t proc     proc     /proc
mount -t sysfs    sysfs    /sys
mount -t devtmpfs devtmpfs /dev 2>/dev/null || mdev -s
mkdir -p /dev/pts
mount -t devpts devpts /dev/pts 2>/dev/null || true

exec 0</dev/console 1>/dev/console 2>/dev/console
log "larch-os installer initramfs starting"

# ── Load kernel modules ───────────────────────────────────────────────────────

log "Loading modules..."

load_mod virtio;             load_mod virtio_ring
load_mod virtio_pci_legacy_dev; load_mod virtio_pci_modern_dev; load_mod virtio_pci
load_mod scsi_common;        load_mod scsi_mod
load_mod virtio_blk;         load_mod virtio_scsi
load_mod nvme_core;          load_mod nvme
load_mod libata;             load_mod libahci;  load_mod ahci; load_mod ata_piix
load_mod sd_mod
load_mod usb_storage;        load_mod uas
load_mod xhci_hcd;           load_mod xhci_pci; load_mod ehci_pci; load_mod uhci_hcd
load_mod usbhid;             load_mod hid_generic; load_mod evdev
load_mod nls_utf8;           load_mod nls_cp437; load_mod nls_ascii
# Target disk filesystems (for mounting after formatting)
load_mod fat;                load_mod vfat
load_mod crc16;              load_mod mbcache; load_mod jbd2
# crc32c_generic must load BEFORE ext4 mounts: ext4 needs the "crc32c" crypto
# alg for metadata checksums and otherwise fails with "Cannot load crc32c driver".
load_mod crc32c_generic
load_mod ext4

log "Modules loaded"

# ── Settle devices ────────────────────────────────────────────────────────────
# Wait up to 10s for at least one block device to appear.
# devtmpfs auto-creates device nodes as modules probe hardware, but there is
# always a small race between modprobe returning and the node appearing.

log "Waiting for storage devices to appear..."
i=0
while [ $i -lt 10 ]; do
    ls /dev/sda /dev/vda /dev/nvme0n1 /dev/mmcblk0 2>/dev/null | grep -q . && break
    sleep 1
    i=$((i+1))
done
log "  /dev contents: $(ls /dev/ 2>/dev/null | tr '\n' ' ' || true)"

# ── Run installer ─────────────────────────────────────────────────────────────
# Both /install.sh and the OS payload (/payload/…) are baked into this initramfs,
# so there is nothing to find or mount — hand straight over to the installer.
# It reads the payload from /payload and writes it to the target disk, then
# calls reboot -f when done.
[ -f /payload/larch-os/initramfs.img ] || \
    die "OS payload missing from initramfs (/payload/larch-os/initramfs.img) — build is broken"

log "Starting installer"
exec /install.sh
