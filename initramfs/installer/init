#!/bin/sh
# larch-os installer initramfs init — PID 1
#
# Loads storage and filesystem modules, locates the installer USB medium
# (ISO9660, label LARCHISO), mounts it at /mnt/iso, then runs
# /usr/sbin/larch-install. All OS files to be installed live on the ISO
# under /larch-os/; the installer reads them from there.
#
# No switch_root: the installer runs to completion from this initramfs,
# then reboots. The larch OS runs only on the installed disk.
set -e

log()     { echo "[larch-install-init] $*" > /dev/console; }
die()     { echo "[larch-install-init] FATAL: $*" > /dev/console; exec sh < /dev/console > /dev/console 2>&1; }
load_mod() { modprobe "$1" 2>/dev/null && log "  [mod] $1" || log "  [mod] SKIP: $1"; }

mount -t proc     proc     /proc
mount -t sysfs    sysfs    /sys
mount -t devtmpfs devtmpfs /dev 2>/dev/null || mdev -s
mkdir -p /dev/pts
mount -t devpts devpts /dev/pts 2>/dev/null || true

log "larch-os installer initramfs starting"

# ── Load modules ──────────────────────────────────────────────────────────────

load_mod isofs
load_mod loop
load_mod fat
load_mod vfat
load_mod nls_utf8
load_mod nls_cp437
load_mod nls_ascii
load_mod crc16
load_mod mbcache
load_mod jbd2
load_mod ext4
load_mod cdrom
load_mod sr_mod

load_mod virtio
load_mod virtio_ring
load_mod virtio_pci_legacy_dev
load_mod virtio_pci_modern_dev
load_mod virtio_pci
load_mod virtio_blk
load_mod virtio_scsi
load_mod scsi_common
load_mod scsi_mod

load_mod libata
load_mod libahci
load_mod ahci
load_mod ata_piix

load_mod nvme-auth
load_mod nvme-core
load_mod nvme

load_mod sd_mod
load_mod usb_common
load_mod usbcore
load_mod usb_storage
load_mod uas
load_mod xhci_hcd
load_mod xhci_pci
load_mod ehci_pci
load_mod uhci_hcd

load_mod hid
load_mod usbhid
load_mod hid_generic
load_mod evdev

# ── Find installer USB medium ─────────────────────────────────────────────────

log "Settling devices..."
udevadm settle 2>/dev/null || sleep 3

log "Searching for installer medium (LABEL=LARCHISO)..."
ISO_DEV=""
_w=0
while [ -z "$ISO_DEV" ]; do
    # Fast path: findfs by volume label.
    # When dd'd to USB the iso9660 spans the whole device (/dev/sdb), but
    # findfs may return a partition (/dev/sdb3) because the GPT that
    # grub-mkrescue embeds makes the kernel create partition entries.
    # Strip the partition suffix to get the whole-disk device to mount.
    ISO_DEV="$(findfs LABEL=LARCHISO 2>/dev/null || true)"
    if [ -n "$ISO_DEV" ]; then
        # When dd'd to USB the iso9660 spans the whole device (/dev/sdb), but
        # findfs may return a partition (/dev/sdb3) because grub-mkrescue embeds
        # a GPT that makes the kernel create partition entries. Strip the suffix
        # to get the parent device. Guard with -b so /dev/sr0 (CD, no parent)
        # is left alone — stripping its digit gives /dev/sr which doesn't exist.
        case "$ISO_DEV" in
            *nvme*p[0-9]*) _parent="${ISO_DEV%p[0-9]*}" ;;
            *[0-9])        _parent="$(echo "$ISO_DEV" | sed 's/[0-9]*$//')" ;;
            *)             _parent="" ;;
        esac
        [ -n "$_parent" ] && [ -b "$_parent" ] && ISO_DEV="$_parent"
        unset _parent
    fi
    # Fallback: scan block devices for iso9660 type
    # /dev/sr? covers CD-ROM drives (QEMU -cdrom, real USB CD-ROMs)
    if [ -z "$ISO_DEV" ]; then
        for _d in $(ls /dev/sr? /dev/sd? /dev/vd? /dev/mmcblk? 2>/dev/null || true); do
            [ -b "$_d" ] || continue
            if [ "$(blkid -s TYPE -o value "$_d" 2>/dev/null)" = "iso9660" ]; then
                ISO_DEV="$_d"; break
            fi
        done
    fi
    [ -n "$ISO_DEV" ] && break
    _w=$((_w + 1))
    [ "$_w" -gt 20 ] && die "Installer medium not found after 20 s — is the USB plugged in?"
    sleep 1
done
unset _w _d

log "Found installer medium: $ISO_DEV"
mkdir -p /mnt/iso
mount -r -t iso9660 "$ISO_DEV" /mnt/iso || die "Failed to mount installer medium at /mnt/iso"
log "Mounted installer medium at /mnt/iso"

# ── Wait for keyboard ─────────────────────────────────────────────────────────
# On real hardware xHCI does a BIOS handoff after loading (up to 5 s) before
# USB devices enumerate. Poll /proc/bus/input/devices until a kbd handler
# appears so the installer prompt isn't shown before the keyboard is ready.
log "Waiting for keyboard..."
_k=0
while ! grep -q "kbd" /proc/bus/input/devices 2>/dev/null; do
    _k=$((_k+1))
    if [ "$_k" -gt 15 ]; then
        log "WARNING: no keyboard detected after 15 s — continuing anyway"
        break
    fi
    sleep 1
done
[ "$_k" -lt 15 ] && log "Keyboard ready (${_k}s)"

# ── Run installer ─────────────────────────────────────────────────────────────
# setsid gives the installer its own session so it can open /dev/tty1 as a
# controlling terminal. Without this, PID 1 has no ctty and read gets no
# keyboard input on real hardware even though console output works fine.

exec setsid cttyhack sh /usr/sbin/larch-install
