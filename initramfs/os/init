#!/bin/sh
# larch-os OS initramfs init — PID 1
#
# Finds the LARCHOS FAT32 partition, loop-mounts rootfs.squashfs from it,
# builds an overlayfs on top, applies per-machine config from the same
# partition, then switch_roots to systemd.
#
# LARCHOS stays mounted after switch_root: the squashfs loop device holds a
# file reference to rootfs.squashfs on that filesystem and prevents unmounting.
# It becomes a detached mount — invisible from the new root's filesystem tree
# but alive in the kernel's mount table.
#
# Sequence:
#   load modules → settle devices → mount LARCHOS → loop-mount squashfs →
#   overlayfs → apply config → switch_root
set -e

# LOG_SINK starts at the console so anything failing before quiet-detection is
# still visible; on a quiet boot it is repointed at /dev/kmsg (see below).
LOG_SINK=/dev/console
log()  { echo "[larch-init] $*" > "$LOG_SINK"; }
die()  { echo "[larch-init] FATAL: $*" > /dev/console; emergency_shell; }

emergency_shell() {
    log "Emergency shell — type 'exit' to continue"
    exec sh < /dev/console > /dev/console 2>&1
}

load_mod() {
    modprobe "$1" 2>/dev/null && log "  [mod] $1" || log "  [mod] SKIP: $1"
}

# ── Early setup ───────────────────────────────────────────────────────────────

mount -t proc     proc     /proc
mount -t sysfs    sysfs    /sys
mount -t devtmpfs devtmpfs /dev 2>/dev/null || mdev -s
mkdir -p /dev/pts
mount -t devpts devpts /dev/pts 2>/dev/null || true
mount -t tmpfs  tmpfs  /dev/shm 2>/dev/null || true

# On a quiet boot, send all initramfs chatter to the kernel ring buffer instead
# of the console: it stays hidden behind `quiet`/loglevel (so the firmware logo
# is not buried under [larch-init] text) but is still captured by dmesg. Pass
# `larch.debug` on the kernel cmdline to keep the verbose console output.
if grep -qw quiet /proc/cmdline && ! grep -qw larch.debug /proc/cmdline; then
    LOG_SINK=/dev/kmsg
fi

exec 1>"$LOG_SINK" 2>"$LOG_SINK"
log "larch-os initramfs starting"

# ── Load modules ──────────────────────────────────────────────────────────────

load_mod squashfs
load_mod loop
load_mod overlay

load_mod fat
load_mod vfat
load_mod nls_utf8
load_mod nls_cp437
load_mod nls_ascii
# ext4 — to read the account files from LARCHCONF
load_mod crc16
load_mod crc32c_generic
load_mod mbcache
load_mod jbd2
load_mod ext4

load_mod virtio
load_mod virtio_ring
load_mod virtio_pci_legacy_dev
load_mod virtio_pci_modern_dev
load_mod virtio_pci
load_mod virtio_blk
load_mod virtio_scsi
load_mod scsi_common
load_mod scsi_mod

load_mod libata
load_mod libahci
load_mod ahci
load_mod ata_piix

load_mod nvme_core
load_mod nvme

load_mod sd_mod
# USB core must load before any USB host controller / storage / HID driver.
load_mod usb_common
load_mod usbcore
load_mod usb_storage
load_mod uas
load_mod xhci_hcd
load_mod xhci_pci
load_mod ehci_pci
load_mod uhci_hcd

# HID stack so a USB keyboard works in the emergency shell. hid (core) must
# load before usbhid / hid_generic. PS/2 keyboards work without this (built-in).
load_mod hid
load_mod usbhid
load_mod hid_generic
load_mod hid-apple
load_mod evdev

# ── Find LARCHOS partition ────────────────────────────────────────────────────
# LARCHOS is the FAT32 boot/system partition written by the installer.
# It holds rootfs.squashfs and the per-machine config files.
# Retry for up to 20 s to handle USB drives that enumerate slowly.

log "Settling devices..."
udevadm settle 2>/dev/null || true

mkdir -p /mnt/config
LARCHOS_DEV=""

try_config_dev() {
    _d="$1"
    [ -b "$_d" ] || return 1
    mount -r -t vfat -o noatime "$_d" /mnt/config 2>/dev/null || return 1
    if [ -e /mnt/config/larch-os/rootfs.squashfs ]; then
        LARCHOS_DEV="$_d"
        return 0
    fi
    umount /mnt/config 2>/dev/null || true
    return 1
}

_w=0
while [ -z "$LARCHOS_DEV" ]; do
    # findfs fast path on first pass (silent if the busybox applet is absent)
    if [ "$_w" -eq 0 ]; then
        _cand="$(findfs LABEL=LARCHOS 2>/dev/null || true)"
        [ -n "$_cand" ] && try_config_dev "$_cand"
    fi
    # Full partition scan — catches devices findfs missed or that appeared late
    if [ -z "$LARCHOS_DEV" ]; then
        for _d in $(ls /dev/vd*[0-9] /dev/sd*[0-9] /dev/nvme*p[0-9]* /dev/mmcblk*p[0-9]* 2>/dev/null || true); do
            try_config_dev "$_d" && break
        done
    fi
    [ -n "$LARCHOS_DEV" ] && break
    _w=$((_w+1))
    [ "$_w" -gt 20 ] && die "LARCHOS partition not found after 20s — cannot boot"
    sleep 1
done
unset _w _cand
log "Found LARCHOS on $LARCHOS_DEV"

# ── Loop-mount squashfs from LARCHOS ─────────────────────────────────────────

SQUASHFS="/mnt/config/larch-os/rootfs.squashfs"
log "squashfs: $(du -sh "$SQUASHFS" 2>/dev/null | cut -f1)"

mkdir -p /mnt/squashfs
mount -r -t squashfs -o loop "$SQUASHFS" /mnt/squashfs || \
    die "Failed to loop-mount squashfs"

# ── OverlayFS (tmpfs upper layer) ─────────────────────────────────────────────

mkdir -p /mnt/overlay /mnt/root
mount -t tmpfs tmpfs /mnt/overlay || die "Failed to mount overlay tmpfs"
mkdir -p /mnt/overlay/upper /mnt/overlay/work
mount -t overlay overlay \
    -o lowerdir=/mnt/squashfs,upperdir=/mnt/overlay/upper,workdir=/mnt/overlay/work \
    /mnt/root || die "Failed to mount overlayfs"

# ── Apply installer config from LARCHOS ──────────────────────────────────────
# Read config files from /larch-os/ on LARCHOS and write them into the overlayfs
# upper (tmpfs) layer so the running system sees the correct hostname, user
# credentials, etc. This happens on every boot — the squashfs lower layer is
# never modified.
#
# LARCHOS is NOT unmounted here: the squashfs loop device holds an open file
# reference to rootfs.squashfs on that filesystem.

log "Applying config from $LARCHOS_DEV"
CFG="/mnt/config/larch-os"

# hostname
if [ -f "$CFG/hostname" ]; then
    mkdir -p /mnt/root/etc
    cp "$CFG/hostname" /mnt/root/etc/hostname
    log "  hostname: $(cat "$CFG/hostname")"
fi

# /etc/hosts
if [ -f "$CFG/hosts" ]; then
    mkdir -p /mnt/root/etc
    cp "$CFG/hosts" /mnt/root/etc/hosts
fi

# /etc/machine-id — apply the installer-generated id so the machine keeps a
# stable identity (DHCP lease/IP, DHCPv6 DUID, journal) across reboots. /etc is
# tmpfs, so without this systemd would synthesise a new id on every boot.
if [ -f "$CFG/machine-id" ]; then
    mkdir -p /mnt/root/etc
    cp "$CFG/machine-id" /mnt/root/etc/machine-id
    chmod 444 /mnt/root/etc/machine-id
    log "  machine-id: $(cat "$CFG/machine-id")"
fi

# Determine installed username (default: larch)
USERNAME="larch"
if [ -f "$CFG/username" ]; then
    USERNAME="$(cat "$CFG/username")"
fi
log "  username: $USERNAME"

# Account files (passwd/shadow) live on LARCHCONF (ext4, root-only), not on
# FAT32 LARCHOS where any mounter could read the hash. Mount it read-only just
# long enough to read them; systemd mounts it read-write later via fstab, and
# larch-persist-accounts.path writes password changes back to it.
# Fall back to LARCHOS for installs that predate the move (and dev disks).
ACCT="$CFG"
mkdir -p /mnt/larchconf
_conf="$(findfs LABEL=LARCHCONF 2>/dev/null || true)"
if [ -n "$_conf" ] && mount -r -t ext4 "$_conf" /mnt/larchconf 2>/dev/null; then
    if [ -f /mnt/larchconf/accounts/passwd ] && [ -f /mnt/larchconf/accounts/shadow ]; then
        ACCT="/mnt/larchconf/accounts"
    fi
fi
unset _conf
log "  accounts: $ACCT"

# /etc/passwd — replace any UID-1000 line from the squashfs default with the
# installer-supplied entry (which has the correct username).
if [ -f "$ACCT/passwd" ]; then
    mkdir -p /mnt/root/etc
    grep -v '^[^:]*:[^:]*:1000:' /mnt/squashfs/etc/passwd > /mnt/root/etc/passwd || true
    cat "$ACCT/passwd" >> /mnt/root/etc/passwd
fi

# /etc/shadow — remove any default "larch" line and the installer username line,
# then append the hashed entry from the installer.
if [ -f "$ACCT/shadow" ]; then
    mkdir -p /mnt/root/etc
    grep -v "^larch:\|^${USERNAME}:" /mnt/squashfs/etc/shadow > /mnt/root/etc/shadow || true
    cat "$ACCT/shadow" >> /mnt/root/etc/shadow
    chmod 640 /mnt/root/etc/shadow
fi

# /etc/localtime — the timezone saved by larch-persist-timezone when it's changed
# in GNOME Settings (absent → the image default, UTC). Only a plain zone name
# that exists in the image's zoneinfo is linked.
if [ -f /mnt/larchconf/timezone ]; then
    _tz="$(head -n 1 /mnt/larchconf/timezone)"
    case "$_tz" in
        ""|/*|*..*|*[!A-Za-z0-9_+/-]*)
            log "  timezone: ignoring invalid '$_tz'" ;;
        *)
            if [ -f "/mnt/root/usr/share/zoneinfo/$_tz" ]; then
                mkdir -p /mnt/root/etc
                ln -sfn "../usr/share/zoneinfo/$_tz" /mnt/root/etc/localtime
                log "  timezone: $_tz"
            else
                log "  timezone: unknown zone '$_tz', keeping default"
            fi ;;
    esac
    unset _tz
fi

# Release LARCHCONF so systemd-fsck can check it before mounting it read-write.
umount /mnt/larchconf 2>/dev/null || true

# /etc/group — rename the default "larch" user entries to the installed username.
if [ "$USERNAME" != "larch" ]; then
    mkdir -p /mnt/root/etc
    sed "s/\blarch\b/$USERNAME/g" /mnt/squashfs/etc/group > /mnt/root/etc/group || true
    # Hide the build-time default user's home (/home/larch from the squashfs).
    # rm against the overlay mount records a whiteout in the tmpfs upper layer;
    # the read-only squashfs lower layer is untouched.
    rm -rf "/mnt/root/home/larch" 2>/dev/null || true
fi

# /etc/fstab — mounts LARCHHOME at /home
# The installer generates a fstab with the home partition mounted at /home
# (the user's home directory is /home/<username> inside that partition).
# systemd-fstab-generator turns this entry into home.mount after switch_root.
if [ -f "$CFG/fstab" ]; then
    mkdir -p /mnt/root/etc
    cp "$CFG/fstab" /mnt/root/etc/fstab
    # Create mount points so systemd doesn't have to
    mkdir -p /mnt/root/etc/larch-conf
    # Fallback home dir in the tmpfs upper layer — only visible if LARCHHOME
    # is absent (the nofail fstab entry skips the mount); otherwise the
    # /home mount hides it. Keeps login working without the partition.
    mkdir -p "/mnt/root/home/$USERNAME"
    chown 1000:1000 "/mnt/root/home/$USERNAME" 2>/dev/null || true
    chmod 0750      "/mnt/root/home/$USERNAME"  2>/dev/null || true
    log "  fstab: LARCHCONF → /etc/larch-conf, LARCHHOME → /home"
fi

log "Config applied"

# /home (LABEL=LARCHHOME) is mounted by systemd via home.mount (generated
# from /etc/fstab) after switch_root.

# ── Move pseudo-filesystems and switch root ───────────────────────────────────

mount --move /proc /mnt/root/proc
mount --move /sys  /mnt/root/sys
mount --move /dev  /mnt/root/dev

log "Switching to real root → systemd"
exec switch_root /mnt/root /lib/systemd/systemd
